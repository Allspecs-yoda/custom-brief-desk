{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Night Shift Foundry custom brief",
  "type": "object",
  "required": ["buyer_handle", "product_name", "audience", "niche", "modules"],
  "additionalProperties": false,
  "properties": {
    "buyer_handle": {"type": "string", "minLength": 2, "maxLength": 40},
    "product_name": {"type": "string", "minLength": 4, "maxLength": 80},
    "audience": {"type": "string", "minLength": 4, "maxLength": 160},
    "niche": {"type": "string", "minLength": 2, "maxLength": 80},
    "trades": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 12
    },
    "modules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"type": "string"}
    },
    "tone": {
      "type": "string",
      "enum": ["plain", "firm", "warm"],
      "default": "plain"
    },
    "include_worked_example": {"type": "boolean", "default": true}
  }
}
